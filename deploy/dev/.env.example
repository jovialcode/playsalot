# Local development defaults. Copy to deploy/dev/.env to override ports or secrets.
POSTGRES_DB=playsalot
POSTGRES_USER=playsalot
POSTGRES_PASSWORD=playsalot
JWT_SECRET=dev-only-secret-do-not-use-in-production
NEXT_PUBLIC_API_URL=http://localhost:2567
NEXT_PUBLIC_WS_URL=ws://localhost:2567
WEB_PORT=3000
GAME_SERVER_PORT=2567
POSTGRES_PORT=5432
REDIS_PORT=6379

# OAuth (social login). Leave a provider's id/secret blank to disable it locally.
# redirect_uri registered in each provider console must be
#   ${OAUTH_CALLBACK_BASE}/api/auth/<provider>/callback
OAUTH_CALLBACK_BASE=http://localhost:2567
WEB_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Admin account provisioned on startup. Leave blank to skip. Log in at /admin/login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-admin-password
