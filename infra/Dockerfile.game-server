# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
RUN npm install -g pnpm@11.17.0 turbo@2.7.2

# 1. Prune the monorepo down to only what @playsalot/game-server needs
FROM base AS pruner
WORKDIR /app
COPY . .
RUN turbo prune @playsalot/game-server --docker

# 2. Install deps and build using the pruned lockfile/sources
FROM base AS installer
WORKDIR /app
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo run build --filter=@playsalot/game-server

# 3. Minimal runtime image
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=installer /app .
EXPOSE 2567
CMD ["node", "apps/game-server/dist/index.js"]
